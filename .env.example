# docker compose reads this file. Copy to .env and edit.

# --- application ---
APP_PORT=8080
# >= 32 random characters. Generate with: openssl rand -base64 48
APP_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# set true when served behind HTTPS (nginx/caddy/traefik)
COOKIE_SECURE=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
QUERY_MAX_ROWS=5000
QUERY_TIMEOUT_SECONDS=30
# seconds a query result is served from the server cache (a data source may set its own); 0 = off
QUERY_CACHE_TTL_SECONDS=0
# distinct values a list filter loads per page; rows an export (CSV / Excel) may hold
FILTER_VALUE_LIMIT=200
EXPORT_MAX_ROWS=50000
# max seconds for one AI provider call (chart suggestions)
AI_TIMEOUT_SECONDS=60
LOG_LEVEL=info

# --- Microsoft Entra ID sign-in (optional; all three required to enable) ---
# App registration → Overview: Directory (tenant) ID and Application (client) ID
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Certificates & secrets → client secret value
ENTRA_CLIENT_SECRET=
# Public callback URL registered as a Web redirect URI (derived from the request when empty)
ENTRA_REDIRECT_URI=
# Comma-separated e-mail domains allowed to sign in (empty = any account of the tenant)
ENTRA_ALLOWED_DOMAINS=
# Create an account on first sign-in (false = only pre-created accounts may sign in)
ENTRA_AUTO_PROVISION=true
# Role for new accounts when no app role / group below matches: admin | editor | viewer
ENTRA_DEFAULT_ROLE=viewer
# App role values (or group object ids) from the token that map to each role
ENTRA_ADMIN_ROLES=
ENTRA_EDITOR_ROLES=
ENTRA_VIEWER_ROLES=
# Set to false to hide the username/password form once Entra sign-in works
AUTH_LOCAL_LOGIN=true

# --- MariaDB container ---
MARIADB_ROOT_PASSWORD=root_pw_change_me
MARIADB_PORT=3306
# metadata account (must match docker/mariadb-init/01-create-databases.sql on first start)
META_DB_USER=studio
META_DB_PASSWORD=studio_pw
META_DB_NAME=report_studio
