# --- server ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# At least 32 random characters. Signs sessions and encrypts data-source passwords.
# Generate: openssl rand -base64 48
APP_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# --- metadata database (dashboards, users, connections) ---
META_DB_HOST=127.0.0.1
META_DB_PORT=3306
META_DB_USER=studio
META_DB_PASSWORD=studio_pw
META_DB_NAME=report_studio

# --- first admin account (created once when the users table is empty) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- query guard rails ---
QUERY_MAX_ROWS=5000
QUERY_TIMEOUT_SECONDS=30
QUERY_POOL_SIZE=4
